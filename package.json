{
  "name": "md-view",
  "version": "0.0.0-scaffold",
  "description": "Electron + TypeScript Markdown previewer desktop app (structural scaffold)",
  "private": true,
  "main": "dist/main/index.js",
  "scripts": {
    "dev": "npm run build && electron .",
    "build": "tsc -p tsconfig.json && node -e \"require('fs').mkdirSync('dist/renderer',{recursive:true});require('fs').copyFileSync('src/renderer/index.html','dist/renderer/index.html')\"",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:e2e": "npm run build && playwright test",
    "test:all": "npm run test:unit && npm run test:integration && npm run test:e2e",
    "package": "electron-builder"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.0",
    "@types/node": "^22.7.0",
    "electron": "^33.0.0",
    "electron-builder": "^25.1.0",
    "playwright": "^1.48.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
